# Base URL of your MoneyMentor edge Worker (worker/). Copy this file to `.env`
# and fill it in. Expo inlines EXPO_PUBLIC_* variables at build time.
#
# Deployed:     https://moneymentor-api.<you>.workers.dev
# Local dev:    http://<your-machine-LAN-IP>:8787   (from `cd worker && npm run dev`)
EXPO_PUBLIC_WORKER_URL=
