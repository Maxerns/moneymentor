# Local secrets for `wrangler dev`. Copy this file to `.dev.vars` (which is
# gitignored) and fill in your keys. wrangler loads .dev.vars automatically.
#
# For a DEPLOYED worker, don't use this file — run instead:
#   npx wrangler secret put TWELVEDATA_API_KEY
#
# Rotate the previously-committed key before using it here.
TWELVEDATA_API_KEY=
# FRED_API_KEY=
# NEWS_API_KEY=
